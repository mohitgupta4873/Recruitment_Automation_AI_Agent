# Copy this file to .env and fill in your values
# Never commit .env to git!

# Django
SECRET_KEY=your-very-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000

# Database (leave blank to use SQLite in dev; Railway sets this automatically)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Google OAuth (paste the full JSON content of client_secrets.json as a single line)
# GOOGLE_CLIENT_SECRETS={"web":{"client_id":"...","client_secret":"..."}}

# Error notifications (optional)
# ADMIN_EMAIL=you@example.com
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
