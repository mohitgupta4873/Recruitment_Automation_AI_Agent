# Copy this file to .env and fill in your values. Never commit .env.
#
# Keep each value on ONE line. A wrapped value silently truncates: the previous
# .env had SECRET_KEY split across two lines, so Django was signing sessions
# with a partial key.

# ── Django core ──────────────────────────────────────────────
# Required. The app refuses to boot without it (no insecure default any more).
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Defaults to False. Set True only for local development.
DEBUG=True

# Comma-separated. Must list your real domain in production; no "*" wildcard.
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated, scheme included. Required in production or every POST 403s.
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ── Cache / rate limiting ────────────────────────────────────
# REQUIRED when DEBUG=False: django-ratelimit needs a shared cache with atomic
# increment, otherwise login and register are effectively unthrottled. Also
# doubles as the Celery broker/backend (interview invites, outcome emails) —
# see my_hiring_project/celery.py. One Redis instance, no separate var needed.
# Leave blank locally: rate limiting falls back to an in-process cache, and
# Celery tasks run eagerly in-process (no worker needed for `runserver` alone).
REDIS_URL=

# ── Database ─────────────────────────────────────────────────
# Blank uses local SQLite. Render/Railway inject this automatically.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Field-level encryption ───────────────────────────────────
# REQUIRED when DEBUG=False: encrypts GoogleOAuthToken.token_json (refresh
# token + client secret) at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank locally — a deterministic dev-only key is derived from SECRET_KEY.
FIELD_ENCRYPTION_KEY=

# ── Google Gemini (JD generation) ────────────────────────────
GEMINI_API_KEY=

# ── Google OAuth ─────────────────────────────────────────────
# Production: paste the full JSON content of client_secrets.json on one line.
# Local dev: leave blank and keep client_secrets.json in the repo root instead.
# GOOGLE_CLIENT_SECRETS={"web":{"client_id":"...","client_secret":"..."}}

# ── Email ────────────────────────────────────────────────────
# Needed for password reset. Use a transactional provider (Resend / SendGrid /
# SES) rather than Gmail SMTP, which has low daily caps and poor deliverability
# from cloud IPs. With DEBUG=True, email prints to the console instead.
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=HireAI <no-reply@yourdomain.com>

# Receives 500-error notifications.
# ADMIN_EMAIL=you@example.com

# ── Static files ─────────────────────────────────────────────
# Defaults to on outside DEBUG/tests. Requires collectstatic to have run.
# USE_MANIFEST_STATIC=True
